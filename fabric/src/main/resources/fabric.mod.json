{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",

  "name": "${mod_name}",
  "description": "${description}",
  "authors": [ "${mod_author}" ],
  "contact": {},

  "license": "${license}",
  "icon": "icon.png",

  "environment": "*",
  "entrypoints": {
    "client": [
      "dev.boxadactle.boxlib.fabric.BoxLibFabric"
    ]
  },
  "depends": {
    "fabricloader": "*",
    "minecraft": "${minecraft_version_range_fabric}",
    "fabric-api": "*"
  },
  "custom": {
    "modmenu": {
      "badges": [ "library" ]
    }
  },
  "mixins": [
    "boxlib.mixins.json",
    "boxlib-common.mixins.json"
  ]
}
